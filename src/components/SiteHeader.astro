---
const { active = '' } = Astro.props;
const link = (label, href, key) => `<li><a href="${href}"${active === key ? ' class="active"' : ''}>${label}</a></li>`;
---
<nav id="navbar">
  <a href="/" class="nav-logo">
    <img src="/img/logotipo-fundo-transparente.png" alt="W7M Designer | Esquadrias e vidraçaria em São José dos Campos">
  </a>
  <div class="nav-right">
    <ul class="nav-links" id="navLinks" set:html={[link('Home', '/', 'home'), link('Sobre', '/sobre/', 'sobre'), link('Serviços', '/servicos/', 'servicos'), link('Blog', '/blog/', 'blog'), link('Galeria', '/galeria/', 'galeria')].join('')} />
    <div class="nav-actions">
      <div class="nav-social">
        <a href="https://www.instagram.com/w7m_vidros/" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.75a4 4 0 0 0-4 4v8.5a4 4 0 0 0 4 4h8.5a4 4 0 0 0 4-4v-8.5a4 4 0 0 0-4-4h-8.5Zm4.25 2.5a5.75 5.75 0 1 1 0 11.5 5.75 5.75 0 0 1 0-11.5Zm0 1.75a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.2-2.05a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z" /></svg>
        </a>
      </div>
      <div class="dropdown-wrapper">
        <button class="nav-cta" id="btnNavOrcamento" type="button" onclick="toggleDropdown('dropdownNav')">Orçamento</button>
        <div class="dropdown-content" id="dropdownNav">
          <a href="https://wa.me/5512981325798?text=Olá,%20vim%20pelo%20site%20da%20W7M%20Designer%20e%20gostaria%20de%20um%20orçamento." target="_blank" rel="noopener">WhatsApp</a>
          <a href="tel:1239419633">Ligar agora</a>
        </div>
      </div>
    </div>
  </div>
  <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
</nav>
<script is:inline>
  window.toggleDropdown = function (id) {
    const dropdown = document.getElementById(id);
    if (dropdown) dropdown.classList.toggle('show');
  };
</script>
