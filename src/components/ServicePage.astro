---
import SeoHead from './SeoHead.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Breadcrumbs from './Breadcrumbs.astro';

const { service } = Astro.props;
const canonical = `https://www.w7mvidros.com.br${service.path}`;
const whatsapp = `https://wa.me/5512981325798?text=${encodeURIComponent(`Olá, vim pela página de ${service.name} e gostaria de solicitar um orçamento.`)}`;
const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Serviços', url: '/servicos/' },
  { name: service.name }
];
const localBusiness = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': 'https://www.w7mvidros.com.br/#localbusiness',
  name: 'W7M Designer', url: canonical, image: `https://www.w7mvidros.com.br${service.image}`, telephone: '+55 12 98132-5798', priceRange: '$$$',
  address: { '@type': 'PostalAddress', streetAddress: 'R. Conceição Aparecida Lima Pereira, 118', addressLocality: 'São José dos Campos', addressRegion: 'SP', addressCountry: 'BR' },
  areaServed: { '@type': 'City', name: 'São José dos Campos' }, sameAs: ['https://www.instagram.com/w7m_vidros/']
};
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: service.name, serviceType: service.name,
  description: service.description, provider: { '@id': 'https://www.w7mvidros.com.br/#localbusiness' }, areaServed: { '@type': 'City', name: 'São José dos Campos' }, url: canonical, image: `https://www.w7mvidros.com.br${service.image}`
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: service.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/img/favicon.ico" />
    <link rel="stylesheet" href="/css/style.css" />
    <SeoHead title={service.title} description={service.description} canonical={canonical} image={service.image} schemas={[localBusiness, serviceSchema, faqSchema]} />
  </head>
  <body>
    <SiteHeader active="servicos" />
    <main>
      <header class="hero service-hero">
        <div class="hero-video-bg"><video autoplay muted loop playsinline preload="metadata" poster={service.image}><source src="/video/video-home-w7mvidros-esquadrias.mp4" type="video/mp4" /></video></div>
        <div class="hero-overlay"></div>
        <div class="hero-content reveal"><div class="hero-badge">{service.eyebrow}</div><h1>{service.intro}</h1><p class="hero-desc">{service.description}</p><div class="hero-actions"><a href={whatsapp} target="_blank" rel="noopener" class="btn-primary">Solicitar orçamento</a><a href="#sobre-o-servico" class="btn-outline">Conhecer solução</a></div></div>
      </header>
      <section id="sobre-o-servico" class="service-copy-section"><div class="service-page-shell"><Breadcrumbs items={breadcrumbs} /><div class="service-copy-grid"><div><div class="section-tag">{service.name} em São José dos Campos</div><h2>Uma solução pensada para o seu ambiente</h2></div><div class="service-copy">{service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></div></section>
      <section class="service-highlights"><div class="section-header"><div class="section-tag">Por que planejar</div><h2>Detalhes que fazem diferença no resultado</h2></div><div class="highlight-grid">{service.highlights.map((item) => <article><span class="highlight-number">{String(service.highlights.indexOf(item) + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
      <section class="service-applications"><div class="service-application-image"><img src={service.image} alt={service.imageAlt} loading="lazy" /></div><div><div class="section-tag">Aplicações</div><h2>Onde essa solução pode ser usada</h2><ul>{service.applications.map((application) => <li>{application}</li>)}</ul><a href={whatsapp} target="_blank" rel="noopener" class="btn-primary">Falar sobre meu projeto</a></div></section>
      <section class="service-regions"><div class="section-header"><div class="section-tag">Atendimento local</div><h2>Projetos em regiões estratégicas de São José dos Campos</h2></div><p>Conheça informações específicas sobre atendimento e soluções em cada região.</p><div class="service-region-links">{service.relatedRegions.map((region) => <a href={region.href}>{region.name} <span>→</span></a>)}</div></section>
      <section class="service-faq"><div class="section-header"><div class="section-tag">Dúvidas frequentes</div><h2>Perguntas sobre {service.shortName.toLowerCase()}</h2></div><div class="faq-container">{service.faqs.map((faq) => <article class="faq-item"><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></section>
      <section class="cta-final service-cta"><div class="section-tag">W7M Designer</div><h2>Vamos conversar sobre o seu projeto?</h2><p>Envie fotos, medidas aproximadas, bairro e a etapa da obra para receber uma orientação inicial.</p><a href={whatsapp} target="_blank" rel="noopener" class="btn-primary">Solicitar orçamento</a></section>
    </main>
    <SiteFooter />
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
<style>
  .service-page-shell { max-width: 1100px; margin: 0 auto; }
  .breadcrumbs { margin-bottom: 45px; color: var(--gray-600); font-size: .82rem; }
  .breadcrumbs a { color: var(--accent); text-decoration: none; }
  .breadcrumb-separator { padding: 0 10px; color: var(--gray-400); }
  .service-copy-section { background: var(--white); }
  .service-copy-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; }
  .service-copy h2 { margin-top: 10px; }
  .service-copy { color: var(--gray-600); line-height: 1.8; font-size: 1.03rem; }
  .service-copy p { margin-bottom: 20px; }
  .service-highlights { background: var(--gray-50); }
  .highlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .highlight-grid article { background: var(--white); border-top: 2px solid var(--accent); padding: 28px; }
  .highlight-number { color: var(--accent); font-weight: 700; letter-spacing: .12em; }
  .highlight-grid h3 { margin: 18px 0 10px; }
  .highlight-grid p, .service-regions p { color: var(--gray-600); line-height: 1.7; }
  .service-applications { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
  .service-application-image { aspect-ratio: 4/3; overflow: hidden; border-radius: 4px; }
  .service-application-image img { width: 100%; height: 100%; object-fit: cover; }
  .service-applications ul { columns: 2; list-style: none; padding: 0; margin: 30px 0; }
  .service-applications li { color: var(--gray-600); padding: 10px 0 10px 20px; position: relative; }
  .service-applications li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: bold; }
  .service-regions { background: var(--gray-50); }
  .service-region-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .service-region-links a { color: var(--blue-800); background: var(--white); border: 1px solid var(--gray-200); padding: 14px 18px; text-decoration: none; border-radius: 4px; transition: .3s; }
  .service-region-links a:hover { color: var(--accent); border-color: var(--accent); }
  .service-region-links span { color: var(--accent); margin-left: 8px; }
  .service-faq { background: var(--white); }
  .service-faq .faq-item { border-bottom: 1px solid var(--gray-200); padding: 22px 0; }
  .service-faq .faq-item p { color: var(--gray-600); line-height: 1.7; }
  .service-cta { text-align: center; background: var(--blue-900); color: var(--white); }
  .service-cta h2 { max-width: 700px; margin: 0 auto 18px; }
  .service-cta p { color: var(--silver); max-width: 650px; margin: 0 auto 32px; }
  @media (max-width: 800px) { .service-copy-grid, .service-applications { grid-template-columns: 1fr; gap: 35px; } .highlight-grid { grid-template-columns: 1fr; } .service-applications ul { columns: 1; } }
</style>
